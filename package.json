{
  "name": "car-rental-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "migrate": "npm run migrate -w apps/api",
    "seed:admin": "npm run seed:admin -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:renter": "npm run dev -w apps/renter-web",
    "dev:owner": "npm run dev -w apps/owner-web",
    "dev:admin": "npm run dev -w apps/admin-web",
    "dev:agent": "npm run dev -w apps/agent-web",
    "build": "npm run build --workspaces --if-present"
  }
}
